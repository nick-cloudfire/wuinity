[Simulation]
Name=Roxborough_global_smoke
LowerLeftLatLon=39.409924,-105.104505
DomainSize=10000.0,11000.0
DeltaTime=1.0
StartDateTime=2001-06-05T11:00:00
EndDateTime=2001-06-06T11:00:00
StopWhenEvacuated=true

[Map]
MapProvider=Mapbox
ZoomLevel=13

[Weather]
WeatherFile=roxborough_weather.csv

[Population]
PopulationFile=population/worldpop_population.csv
CullOutsideGroups=true

[Demographics]
Name=one_car
Default=true
AllowMoreThanOneCar=false
MaxCars=1
MaxCarsProbability=0.3

[Evacuation]
UseTriggerBufferEvacuation=false
TriggerBufferFile=fire/trigger_buffer.asc

[Destination]
Name=goal_highway
LatLon=39.5071781907873, -105.02231033756013
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=1.0,1.0,1.0

[Destination]
Name=goalE
LatLon=39.427991, -105.073289
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=1.0,0.0,0.0

[Destination]
Name=goalF
LatLon=39.466157, -105.082197
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=.0,1.0,0.0

[Destination]
Name=goalR
LatLon=39.473858, -105.092137
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=0.0,0.0,1.0

[ResponseCurve]
Name=observed_average
TimeInput=Relative
0, 0
300, 0.037
1080, 0.67
1860, 0.76
1980, 0.85
6300, 1.0

[ResponseCurve]
Name=reported_average
TimeInput=Relative
0, 0
900, 0.79
1800, 0.91
2700, 0.93
3600, 0.97
5400, 1.0

[EvacuationGroup]
Name=groupA
EvacuationOrderDateTime=2001-06-05T11:00:00
Demographics=one_car
DestinationChoice=EvacGroupCDF
ShapeFile=groups/groupA.shp
ResponseCurves=observed_average
ResponseCurvesCDF=1.0
Destinations=goalE, goalR, goalF
DestinationsCDF=0.4,0.7,1.0
Color=1.0,1.0,0.0

[EvacuationGroup]
Name=groupB
EvacuationOrderDateTime=2001-06-05T11:00:00
Demographics=one_car
ShapeFile=groups/groupB.shp
DestinationChoice=EvacGroupCDF
Destinations=goalE, goalR, goalF
DestinationsCDF=0.25, 0.75, 1.0
ResponseCurves=observed_average
ResponseCurvesCDF=1.0
Color=1.0,1.0,0.0

[EvacuationGroup]
Name=groupC
EvacuationOrderDateTime=2001-06-05T11:00:00
Demographics=one_car
ShapeFile=groups/groupC.shp
DestinationChoice=EvacGroupCDF
Destinations=goalE, goalR, goalF
DestinationsCDF=0.1, 0.2, 1.0
ResponseCurves=observed_average
ResponseCurvesCDF=1.0
Color=0.0,1.0,0.0

[PedestrianModule]
Enabled=true
Module=MacroHouseholdSim

[MacroHouseholdSim]
WalkingSpeedMinMax=0.7,1.0
WalkingSpeedModifier=1.0
WalkingDistanceModifier=1.0

[TrafficModule]
Enabled=true
Module=SUMO
VisibilityAffectsSpeed=false

[SUMO]
ConfigurationFile=sumo/rox.sumocfg
SmokeAlpha=0.4967
SmokeBeta=-0.02910

[WildfireModule]
Enabled=true
Module=AscImport

[AscImport]
StartDateTime=2001-06-05T11:00:00
TimeOfArrivalFile=flammap/output/TOA.asc
TimeOfArrivalUnits=Minutes
RateOfSpreadFile=flammap/output/ROS.asc
SpreadDirectionFile=flammap/output/SD.asc
FirelineIntensityFile=flammap/output/FI.asc

[Landscape]
LandscapeFile=fire/rox_big_burning_city.lcp

[TriggerBufferModule]
Enabled=false
Module=kPERIL

[kPERIL]
OutputName=trigger_buffer.asc

[SmokeModule]
Enabled=true
Module=GlobalSmoke

[GlobalSmoke]
ExtinctionFile=globalSmoke/extCoeffRamp.exc
