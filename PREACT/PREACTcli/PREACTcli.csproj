<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Off like PREACTcore, whose API it calls: the code is not null-annotated, so "enable" only produced
         a warning per null check. -->
    <Nullable>disable</Nullable>
    <AssemblyName>PREACTcli</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <!-- Warnings are errors: the build is warning-free and should stay so, since a warning left in a
         build that has none is easy to see and one among hundreds is not. NuGet's own warnings
         (NU1xxx) stay warnings: they describe the restore on the machine at hand - a package resolved at
         another version than asked (NU1603, NU1605), one built for another framework (NU1701), a feed that
         cannot be reached (NU1801), the vulnerability audit's online advisories (NU1901-NU1904) - which a
         fixed package set does not decide, so one would otherwise stop the build on one machine and not on
         the next. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1500;NU1501;NU1502;NU1503;NU1504;NU1505;NU1506;NU1507;NU1508;NU1510;NU1511;NU1601;NU1602;NU1603;NU1604;NU1605;NU1608;NU1609;NU1701;NU1702;NU1703;NU1801;NU1802;NU1803;NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>
    <!-- The .NET analyzers' default rule set of the SDK this was checked with, so a newer SDK on the build
         machine does not turn its new default rules into errors. -->
    <AnalysisLevel>8.0</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PREACTcore\PREACTcore.csproj" />
  </ItemGroup>

  <!-- The regression tests exercise the CLI's argument parsing and realization bookkeeping directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PREACTtests" />
  </ItemGroup>

  <!-- The GDAL C# bindings P/Invoke into gdal_wrap.dll by bare name, so it has to sit next to the
       executable (or on PATH). PREACTcore's own copy rules preserve the Runtimes\Native\GDAL\x64
       subpath, which .NET's native resolver does not search - build-case's warp/derive steps then
       fail unless the machine happens to have that folder on PATH. Flatten them into the output
       root so the CLI resolves GDAL by itself.
       Note this only supplies the P/Invoke shims; the GDAL core itself (gdal.dll and its PROJ
       data) still comes from a system install - see docs/probabilistic-trigger-convergence.md. -->
  <!-- NFDRS4core.dll is the same story: the Nelson dead-fuel-moisture engine P/Invokes it by bare
       name, so build-case's moisture stage dies with a NFDRS4corePINVOKE type-initializer error
       unless it sits beside the executable. -->
  <ItemGroup>
    <None Include="..\PREACTcore\Runtimes\Native\GDAL\x64\*.dll;..\PREACTcore\Runtimes\Native\NFDRS4\x64\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
