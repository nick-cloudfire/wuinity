<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- annotations, not enable: the engine was never written against nullable flow analysis, which buried
         the handful of real warnings under ~400 CS86xx ones. `?` annotations stay legal; turn full analysis
         on per file (#nullable enable) once a file is actually annotated. -->
    <Nullable>annotations</Nullable>
    <RootNamespace>PREACT</RootNamespace>
    <!-- Release builds land in Unity Assets; Debug builds go to local bin/ -->
    <BaseOutputPath Condition="'$(Configuration)' == 'Release'">..\..\WUInity\Assets\PREACT\</BaseOutputPath>
    <BaseOutputPath Condition="'$(Configuration)' != 'Release'">bin\</BaseOutputPath>
    <!-- Warnings are errors: the build is warning-free and should stay so, since a warning left in a
         build that has none is easy to see and one among hundreds is not. NuGet's vulnerability audit
         (NU1901-NU1904) stays a warning: it reads an online advisory database that changes under a fixed
         package set, so a new advisory would otherwise stop every build until the package is replaced. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Source\Evacuation\Traffic\Modules\SUMO\Build_notes.txt" />
    <Content Include="Source\Evacuation\Traffic\Modules\SUMO\version_info.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GeoTimeZone" Version="6.1.0" />
    <PackageReference Include="Itinero" Version="1.5.1" />
    <PackageReference Include="Itinero.IO.Osm" Version="1.5.1" />
    <!-- Pin OsmSharp to the version Itinero.IO.Osm 1.5.1 links against (6.2.0.0).
         The old OsmSharp.IO.API package (unused) pulled OsmSharp 7.0-pre, which is
         binary-incompatible with Itinero.IO.Osm and broke OSM->routerDb builds. -->
    <PackageReference Include="OsmSharp" Version="6.2.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.5" />
    <PackageReference Include="TimeZoneConverter" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The managed GDAL wrappers and Open-Meteo are committed under Runtimes/, and referenced from there.
         These used to point at a ThirdParty/ folder that does not exist, and only resolved because the
         SDK's default None glob made every DLL under the project a candidate - any stray DLL there
         could have been picked instead. gdalconst is not referenced: nothing in the engine, k-PERIL or
         gdal_csharp itself uses it. -->
    <Reference Include="gdal_csharp">
      <HintPath>Runtimes\Native\GDAL\gdal_csharp.dll</HintPath>
    </Reference>
    <Reference Include="ogr_csharp">
      <HintPath>Runtimes\Native\GDAL\ogr_csharp.dll</HintPath>
    </Reference>
    <Reference Include="osr_csharp">
      <HintPath>Runtimes\Native\GDAL\osr_csharp.dll</HintPath>
    </Reference>
    <Reference Include="OpenMeteo">
      <HintPath>Runtimes\Managed\Open-Meteo-DotNet\OpenMeteo.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Vendored k-PERIL trigger-boundary engine (retargeted to netstandard2.1). -->
    <ProjectReference Include="..\kPERILcore\kPERILcore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Runtimes\Native\FOFEM\x64\FOFEM.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Runtimes\Native\GDAL\x64\gdal_wrap.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Runtimes\Native\GDAL\x64\libgdal_wrap.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Runtimes\Native\GDAL\x64\libogr_wrap.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Runtimes\Native\GDAL\x64\libosr_wrap.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Runtimes\Native\GDAL\x64\ogr_wrap.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Runtimes\Native\GDAL\x64\osr_wrap.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Runtimes\Native\NFDRS4\x64\libNFDRS4core.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Runtimes\Native\NFDRS4\x64\NFDRS4core.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
