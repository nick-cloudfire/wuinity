<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU</Platforms>
    <RootNamespace>PREACT</RootNamespace>
    <AssemblyName>PREACT</AssemblyName>
    <!-- Matches PREACTcli. Without it PREACT.exe refuses to start on a machine that has a newer
         .NET than 8 installed but not 8 itself, which is what the probabilistic-trigger drivers
         hit: they spawn PREACT.exe per realization, so the whole pipeline fails at the evacuation
         step while the CLI that launched it runs fine. -->
    <RollForward>LatestMajor</RollForward>
    <!-- Warnings are errors: the build is warning-free and should stay so, since a warning left in a
         build that has none is easy to see and one among hundreds is not. NuGet's vulnerability audit
         (NU1901-NU1904) stays a warning: it reads an online advisory database that changes under a fixed
         package set, so a new advisory would otherwise stop every build until the package is replaced. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- The .NET analyzers' default rule set of the SDK this was checked with, so a newer SDK on the build
         machine does not turn its new default rules into errors. -->
    <AnalysisLevel>8.0</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PREACTcore\PREACTcore.csproj" />
  </ItemGroup>

</Project>
