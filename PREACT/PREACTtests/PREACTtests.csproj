<Project Sdk="Microsoft.NET.Sdk">

  <!-- Regression tests for the engine, as a plain console runner: the local NuGet feed has no test
       framework, and none is needed. Exit code 0 = every test passed. Built by the harness with every
       other PREACT project; run it with
         dotnet PREACT/PREACTtests/bin/Debug/net8.0/PREACTtests.dll [file.wui ...]
       (Linux: LD_LIBRARY_PATH must contain the GDAL 3.10 libgdal.so.36). See Program.cs for options. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>PREACT.Tests</RootNamespace>
    <AssemblyName>PREACTtests</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <!-- Warnings are errors: the build is warning-free and should stay so, since a warning left in a
         build that has none is easy to see and one among hundreds is not. NuGet's own warnings
         (NU1xxx) stay warnings: they describe the restore on the machine at hand - a package resolved at
         another version than asked (NU1603, NU1605), one built for another framework (NU1701), a feed that
         cannot be reached (NU1801), the vulnerability audit's online advisories (NU1901-NU1904) - which a
         fixed package set does not decide, so one would otherwise stop the build on one machine and not on
         the next. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1500;NU1501;NU1502;NU1503;NU1504;NU1505;NU1506;NU1507;NU1508;NU1510;NU1511;NU1601;NU1602;NU1603;NU1604;NU1605;NU1608;NU1609;NU1701;NU1702;NU1703;NU1801;NU1802;NU1803;NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>
    <!-- The .NET analyzers' default rule set of the SDK this was checked with, so a newer SDK on the build
         machine does not turn its new default rules into errors. -->
    <AnalysisLevel>8.0</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PREACTcore\PREACTcore.csproj" />
    <!-- For the CLI tests (argument parsing, PREACT.exe exit codes, finding PREACT.exe); internals are visible. -->
    <ProjectReference Include="..\PREACTcli\PREACTcli.csproj" />
    <!-- Built, not referenced: the CLI tests run PREACT.exe itself, so building the tests must build it too. -->
    <ProjectReference Include="..\PREACTexecute\PREACTexecute.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- The GUI's tool probe (Help > External tools and keys) uses no Unity, so it is compiled into the tests too: which
       path wins for each tool, and what the window is told about the ones that do not. -->
  <ItemGroup>
    <Compile Include="..\..\WUInity\Assets\WUInity\GUI\Workflow\ExternalTools.cs" Link="Gui\ExternalTools.cs" />
  </ItemGroup>

  <!-- The GDAL wrappers PREACTcore references by path (they do not flow through a project reference), for the
       tests that open what the engine writes the way GDAL and QGIS will. -->
  <ItemGroup>
    <Reference Include="gdal_csharp">
      <HintPath>..\PREACTcore\Runtimes\Native\GDAL\gdal_csharp.dll</HintPath>
    </Reference>
    <Reference Include="osr_csharp">
      <HintPath>..\PREACTcore\Runtimes\Native\GDAL\osr_csharp.dll</HintPath>
    </Reference>
    <!-- To write the shapefile an evacuation group is read from (CaseBuildTests). -->
    <Reference Include="ogr_csharp">
      <HintPath>..\PREACTcore\Runtimes\Native\GDAL\ogr_csharp.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
