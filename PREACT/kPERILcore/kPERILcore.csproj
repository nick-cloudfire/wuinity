<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vendored from https://github.com/nick-cloudfire/kPERIL (kPERILdll), retargeted
       to netstandard2.1 so PREACTcore and the Unity visualizer can consume it.
       netstandard2.1 lacks PriorityQueue<,>, provided by source/PriorityQueueShim.cs.
       GDAL is shared with PREACTcore (same wrappers) rather than the GDAL NuGet, so
       there is a single GDAL in the build. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- annotations: the vendored source uses ? annotations (CS8632 under disable) but was never written
         against nullable flow analysis. -->
    <Nullable>annotations</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>kPERIL</RootNamespace>
    <AssemblyName>kPERILcore</AssemblyName>
    <!-- Warnings are errors: the build is warning-free and should stay so, since a warning left in a
         build that has none is easy to see and one among hundreds is not. NuGet's vulnerability audit
         (NU1901-NU1904) stays a warning: it reads an online advisory database that changes under a fixed
         package set, so a new advisory would otherwise stop every build until the package is replaced. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="gdal_csharp">
      <HintPath>..\PREACTcore\Runtimes\Native\GDAL\gdal_csharp.dll</HintPath>
    </Reference>
    <Reference Include="ogr_csharp">
      <HintPath>..\PREACTcore\Runtimes\Native\GDAL\ogr_csharp.dll</HintPath>
    </Reference>
    <Reference Include="osr_csharp">
      <HintPath>..\PREACTcore\Runtimes\Native\GDAL\osr_csharp.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
